import std;

Player {
     var jumpCounter: num;
     var isCool: bool;
}

rule "Is cool?" OngoingEachPlayer() {
    cond player.isReloading;

    player.isCool = true;
    player.sendSmallMessage("You are cool now!");
}

rule "Jump Counter" OngoingEachPlayer() {
    cond player.isCool && player.isJumping;

    player.jumpCounter += 1;
    player.sendSmallMessage(player.jumpCounter);
}

